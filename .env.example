# Required for the live upload workbench. The live route fails closed without it.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_LINKING_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SEARCH_MODEL=gpt-5.6-sol
OPENAI_COACH_MODEL=gpt-5.6-sol
OPENAI_SEARCH_TRANSCRIPTION_MODEL=whisper-1
UNSEEN_ALLOWED_EMAILS=owner@example.com,tester@example.com
# Leave blank for OpenAI Sites. GitHub deployment sets this to cloudflare_access.
UNSEEN_AUTH_PROVIDER=
# Required when UNSEEN_AUTH_PROVIDER=cloudflare_access. The issuer must be the
# HTTPS team domain shown by Access, for example https://your-team.cloudflareaccess.com.
UNSEEN_CLOUDFLARE_ACCESS_ISSUER=
# Cloudflare Access application AUD tag. The app verifies this claim and the JWT signature.
UNSEEN_CLOUDFLARE_ACCESS_AUD=
# Localhost only: bypass hosted sign-in while running the development server.
UNSEEN_LOCAL_AUTH_BYPASS=true
# Optional service-to-service bearer. Send only in the x-unseen-service-token header.
UNSEEN_API_ACCESS_TOKEN=
